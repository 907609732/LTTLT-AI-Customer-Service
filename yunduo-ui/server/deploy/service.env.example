LINGTU_LISTEN_HOST=127.0.0.1
LINGTU_API_ORIGIN=https://api-kefu.lttlt.top
LINGTU_PORTAL_ORIGIN=https://account-kefu.lttlt.top
LINGTU_MASTER_KEY_FILE=/opt/lingtu-kefu/shared/master.key
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://account-kefu.lttlt.top,https://api-kefu.lttlt.top
TRUSTED_PROXIES=127.0.0.1,::1
SQLITE_PATH=/opt/lingtu-kefu/shared/managed.db
SQL_MAX_IDLE_CONNS=2
SQL_MAX_OPEN_CONNS=4
GOMEMLIMIT=192MiB
GOGC=50
GIN_MODE=release
DEFAULT_LANGUAGE=zh-CN
# SESSION_SECRET must be generated on the server and never committed.
