{
  "name": "yunduo-ui-restored",
  "version": "1.0.0",
  "private": true,
  "description": "云朵客服 Vue/Electron 本机自带模型密钥版本",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:desktop": "node scripts/build-electron.mjs",
    "electron:dev": "npm run build:desktop && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json",
    "lint": "eslint src electron tests scripts vite.config.ts && node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:desktop": "npm run build && node scripts/run-desktop.mjs",
    "build": "vite build && npm run build:desktop",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:vendor && npm test && npm run test:upstream && npm run build",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "test:upstream": "node --test vendor/lingtu-runtime/tests/*.test.mjs vendor/lingtu-runtime/desk-v1/test/*.test.js",
    "check:vendor": "node scripts/check-vendor.mjs"
  },
  "dependencies": {
    "element-plus": "2.8.8",
    "js-tiktoken": "1.0.21",
    "minisearch": "7.2.0",
    "papaparse": "5.7.1",
    "pinia": "2.2.8",
    "vue": "3.5.11",
    "vue-router": "4.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "concurrently": "9.2.5",
    "cross-env": "7.0.3",
    "electron": "33.4.11",
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "eslint-plugin-vue": "9.32.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "vue-eslint-parser": "9.4.3",
    "vue-tsc": "2.2.0",
    "wait-on": "8.0.5"
  },
  "type": "module"
}
