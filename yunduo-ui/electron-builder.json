{
  "appId": "top.lttlt.yunduo.customer.service",
  "productName": "云朵客服",
  "executableName": "YunduoCustomerService",
  "asar": true,
  "npmRebuild": false,
  "directories": { "output": "release" },
  "files": [
    "dist/**/*",
    "dist-electron/main.cjs",
    "dist-electron/preload.cjs",
    "vendor/lingtu-runtime/electron/**/*",
    "vendor/lingtu-runtime/shared/**/*",
    "vendor/lingtu-runtime/desk-v1/src/**/*",
    "vendor/lingtu-runtime/desk-v1/package.json",
    "vendor/lingtu-runtime/package.json",
    "vendor/lingtu-runtime/PROVENANCE.md",
    "vendor/lingtu-runtime/source-files.json",
    "vendor/lingtu-runtime/LICENSE*",
    "vendor/lingtu-runtime/LICENSING.md",
    "vendor/lingtu-runtime/*NOTICES*",
    "package.json",
    "README.md",
    "docs/PACKAGING.md",
    "!**/*.map"
  ],
  "win": { "target": ["nsis", "zip"], "signAndEditExecutable": false },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "YunduoCustomerService-Setup-${version}-win-${arch}.${ext}"
  },
  "artifactName": "YunduoCustomerService-${version}-win-${arch}.${ext}"
}
