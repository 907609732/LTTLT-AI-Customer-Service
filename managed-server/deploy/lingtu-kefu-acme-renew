#!/bin/bash
set -euo pipefail
umask 077
export ALICLOUD_RAM_ROLE=lingtu-acme-renewal
export ALICLOUD_TTL=600
export ALICLOUD_PROPAGATION_TIMEOUT=1800
exec /usr/local/bin/lingtu-lego run --accept-tos --account-id lingtu-websites \
 --path /var/lib/lingtu-acme --server letsencrypt --dns alidns \
 --cert.name lingtu-kefu --domains account-kefu.lttlt.top --domains api-kefu.lttlt.top \
 --dns.resolvers ns1.alidns.com:53 --dns.resolvers ns2.alidns.com:53 \
 --deploy-hook /usr/local/sbin/lingtu-kefu-acme-deploy "$@"
