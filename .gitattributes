# 维护源码统一使用 LF；vendor 按原始字节保存，避免 Windows 换行转换破坏来源 SHA256。
* text=auto eol=lf
vendor/lingtu-runtime/** -text whitespace=cr-at-eol
# Imported server manifests hash original bytes; preserve them on Windows and CI.
server/** -text whitespace=cr-at-eol
# Parser fixture formats contain byte offsets / ZIP contents; preserve bytes on every platform.
tests/fixtures/knowledge-ingestion/*.pdf binary
tests/fixtures/knowledge-ingestion/*.docx binary
tests/fixtures/knowledge-ingestion/*.xlsx binary
tests/fixtures/knowledge-ingestion/*.png binary
