{
  "appId": "top.lttlt.yunduo.customer.service",
  "productName": "灵兔AI电商客服",
  "executableName": "LingtuAI",
  "asar": true,
  "npmRebuild": false,
  "extraResources": [
    {
      "from": "dist-electron/lingtu-mcp.cjs",
      "to": "ai-interface/lingtu-mcp.cjs"
    },
    {
      "from": "node_modules/@modelcontextprotocol/server/LICENSE",
      "to": "ai-interface/licenses/mcp-server-LICENSE"
    },
    {
      "from": "node_modules/@modelcontextprotocol/core/LICENSE",
      "to": "ai-interface/licenses/mcp-core-LICENSE"
    }
  ],
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/main.cjs",
    "dist-electron/preload.cjs",
    "vendor/lingtu-runtime/electron/**/*",
    "vendor/lingtu-runtime/shared/**/*",
    "vendor/lingtu-runtime/desk-v1/src/**/*",
    "vendor/lingtu-runtime/desk-v1/package.json",
    "vendor/lingtu-runtime/package.json",
    "vendor/lingtu-runtime/PROVENANCE.md",
    "vendor/lingtu-runtime/source-files.json",
    "vendor/lingtu-runtime/LICENSE*",
    "vendor/lingtu-runtime/LICENSING.md",
    "vendor/lingtu-runtime/*NOTICES*",
    "vendor/xianyu-bridge/bridge.js",
    "vendor/xianyu-bridge/PROVENANCE.md",
    "package.json",
    "README.md",
    "LICENSE",
    "docs/legal/LICENSING.md",
    "docs/legal/COMMERCIAL_LICENSE.md",
    "docs/legal/THIRD_PARTY_NOTICES.md",
    "docs/PACKAGING.md",
    "!**/*.map"
  ],
  "win": {
    "target": ["nsis", "zip"],
    "signExecutable": false,
    "icon": "public/lingtu-ai.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "LingtuAI-Setup-${version}-win-${arch}.${ext}",
    "installerIcon": "public/lingtu-ai.ico",
    "uninstallerIcon": "public/lingtu-ai.ico",
    "installerHeaderIcon": "public/lingtu-ai.ico"
  },
  "artifactName": "LingtuAI-${version}-win-${arch}.${ext}"
}
