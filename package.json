{
  "name": "lingtu-ai-customer-service",
  "productName": "灵兔客服",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local-first Electron frontend foundation for Lingtu customer service",
  "author": "LTTLT",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:electron": "node tests/electron-smoke.mjs",
    "test:packaged": "node tests/package-smoke.mjs",
    "design:import": "node scripts/import-design.mjs",
    "design:decode": "node scripts/decode-fig.mjs",
    "design:prepare": "node scripts/prepare-design.mjs",
    "pack:win": "npm run build && electron-builder --win --dir --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "test:backend": "node --test desk-v1/test/*.test.js",
    "test:integration": "node tests/backend-electron.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.12",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "openfig-core": "^0.4.1",
    "typescript": "^5.9.0",
    "vite": "8.3.6"
  },
  "build": {
    "appId": "top.lttlt.customer.service",
    "productName": "灵兔客服",
    "executableName": "LingtuCustomerService",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "LICENSE",
      "LICENSING.md",
      "THIRD_PARTY_NOTICES.md",
      "docs/FRONTEND_HANDOFF.md",
      "package.json",
      "desk-v1/package.json",
      "desk-v1/src/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true,
      "icon": "public/brand/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "907609732",
      "repo": "LTTLT-AI-Customer-Service",
      "private": false,
      "releaseType": "release"
    },
    "artifactName": "LingtuCustomerService-Setup-${version}.${ext}"
  }
}
