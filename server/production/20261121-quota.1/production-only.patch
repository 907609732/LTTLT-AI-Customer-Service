+              <Button
+                disabled={props.busy || !canSubmit}
+                onClick={() => void submit()}
+              >
+                {t('Apply to selected accounts')}
+              </Button>
+              <Button variant='ghost' onClick={() => setOpen(false)}>
+                {t('Cancel')}
+              </Button>
+            </div>
+          </fieldset>
+        </CardContent>
+      )}
+    </Card>
+  )
+}
